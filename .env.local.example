# ── Supabase ─────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Find these in Supabase Dashboard → Project Settings → API.

SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key

# UUID of this tenant's row in the `tenants` table.
# Get it by running supabase/seed.sql and copying the returned id.
STORE_ID=your-store-uuid

# ── Resend (merchant order notification emails) ────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Sender shown on the notification email. Must be on a domain
# verified in Resend. For local testing, "onboarding@resend.dev"
# works (Resend only delivers it to your account's own email).
RESEND_FROM_EMAIL=Clara's Bakehouse <onboarding@resend.dev>
